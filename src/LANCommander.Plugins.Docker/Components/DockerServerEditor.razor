@* The Docker engine's part of a server's General page: which host and container the server is *@
@inject DockerHosts Hosts
@inject ContainerService Containers
@inject NotificationService Notifications

<div class="edit-form-pair">
    <FormItem Label="Docker host">
        <ChildContent>
            <Select TValue="Guid?" Items="HostItems" Value="Settings.HostId" ValueChanged="SetHostAsync" Placeholder="Choose a host" />
        </ChildContent>
        <HelpTemplate>
            @if (!Hosts.All.Any())
            {
                <span>No Docker hosts yet. Add one under <a href="@DockerRoutes.Hosts">Settings → Docker Hosts</a>.</span>
            }
        </HelpTemplate>
    </FormItem>
    <FormItem Label="Container" Class="edit-form-mono">
        <ChildContent>
            <Flex Gap="Gap.Small">
                <Select TValue="string" Items="ContainerItems" Value="Settings.ContainerId" ValueChanged="SetContainerAsync" Disabled="Settings.HostId == null" Placeholder="Choose a container" Searchable />
                <Button Icon="IconType.ArrowClockwise" title="Refresh" Disabled="Settings.HostId == null" Loading="_loading" OnClick="LoadContainersAsync" />
                <Button Icon="IconType.Plus" title="Create a container" Disabled="Settings.HostId == null" OnClick="StartCreating" />
            </Flex>
        </ChildContent>
        <HelpTemplate>
            @if (_error != null)
            {
                <Typography Danger>@_error</Typography>
            }
        </HelpTemplate>
    </FormItem>
</div>

<FormItem Label="Files folder" Class="edit-form-mono" Help="The folder in the container the server's Files page shows, such as its data volume. Empty for the container's working directory.">
    <TextInput Value="@Settings.FilesPath" ValueChanged="SetFilesPath" Disabled="string.IsNullOrWhiteSpace(Settings.ContainerId)" Placeholder="@(String.IsNullOrWhiteSpace(_workingDirectory) ? "/" : _workingDirectory)" />
</FormItem>

<FormItem Label="Log files" Class="edit-form-mono" Help="Log files the server writes in its container, each shown as a console under its Monitor. While the server runs they're followed as they're written; while it's stopped, the end of each is shown as it was left, which only works for files on disk: with LANCommander's server images, under /config/Overlay rather than /config/Merged.">
    <Flex Vertical Gap="Gap.Small">
        @{ var logFiles = Settings.LogFiles; }
        @for (var i = 0; i < logFiles.Count; i++)
        {
            var index = i;
            var file = logFiles[i];

            <Flex Gap="Gap.Small" Align="Align.Center">
                <TextInput Value="@file.Name" ValueChanged="(string? name) => SetLogFile(index, name, null)" Placeholder="Server log" />
                <TextInput Value="@file.Path" ValueChanged="(string? path) => SetLogFile(index, null, path)" Placeholder="/config/Overlay/System/server.log" />
                <Button Text Danger Icon="IconType.X" title="Remove" OnClick="() => ChangeLogFiles(files => { if (index < files.Count) files.RemoveAt(index); })" />
            </Flex>
        }
        <Button Icon="IconType.Plus" Disabled="string.IsNullOrWhiteSpace(Settings.ContainerId)" OnClick="AddLogFile">Add Log File</Button>
    </Flex>
</FormItem>

@if (_creating is { } creating && Settings.HostId is { } creatingOn)
{
    <Card Title="Create a container" Subtitle="@(_draft == null ? "The image is pulled and read, to fill in its ports, volumes and settings" : "Filled in from the image; check the ports before creating it")">
        @if (_draft is { } draft)
        {
            <ContainerForm Spec="draft" HostId="creatingOn" ImageFixed />

            @if (draft.GameFiles is { } gameFiles)
            {
                <FormItem Help="@(_gameFilesSharedWith.Count > 0 ? $"Already used by {string.Join(", ", _gameFilesSharedWith)}, so the game is likely installed there." : "No other server uses these game files yet. Servers sharing game files don't update them when they start, and some images then don't install them either.")">
                    <Checkbox @bind-Value="_installGameFiles">Install the game files in @gameFiles.Source now, as Update Game Files does</Checkbox>
                </FormItem>
            }
        }
        else
        {
            <div class="edit-form-pair">
                <FormItem Label="Name" Class="edit-form-mono">
                    <TextInput @bind-Value="creating.Name" />
                </FormItem>
                <FormItem Label="Image" Class="edit-form-mono" Help="Pulled if the host doesn't have it. LANCommander's server images are lancommander/<game>.">
                    <TextInput @bind-Value="creating.Image" Placeholder="lancommander/quake3:latest" />
                </FormItem>
            </div>
        }

        @if (_progress != null)
        {
            <Typography Secondary>@_progress</Typography>
        }

        <Flex Gap="Gap.Small">
            @if (_draft == null)
            {
                <Button Primary Loading="_creatingNow" OnClick="ReadImageAsync">Next</Button>
            }
            else
            {
                <Button Primary Loading="_creatingNow" OnClick="CreateAsync">Create</Button>
                <Button Disabled="_creatingNow" OnClick="() => _draft = null">Back</Button>
            }
            <Button Text Disabled="_creatingNow" OnClick="CancelCreating">Cancel</Button>
        </Flex>
    </Card>
}

<GameFilesLog Lines="_gameFilesLog" OnClose="() => _gameFilesLog = []" />

@if (_container is { } container)
{
    <Card Title="@container.Name" Subtitle="@container.Image">
        <Extra>
            <Tag Success="@(_state == "running")">@_status</Tag>
        </Extra>
        <ChildContent>
            <Flex Vertical Gap="Gap.Small">
                @if (!string.IsNullOrWhiteSpace(container.IPAddress) && container.Ports.Count > 0)
                {
                    <Typography Secondary Small>Ports at its own address, @container.IPAddress</Typography>
                    <Flex Gap="Gap.Small" Wrap>
                        @foreach (var port in container.Ports)
                        {
                            <Button Small Text title="Use as the address and port players connect to" OnClick="() => UsePort(port)">
                                <Typography Code>@container.IPAddress:@port.Key</Typography>
                            </Button>
                        }
                    </Flex>
                }
                else if (container.Ports.Any(p => p.HostPort != null))
                {
                    <Typography Secondary Small>Published ports</Typography>
                    <Flex Gap="Gap.Small" Wrap>
                        @foreach (var port in container.Ports.Where(p => p.HostPort != null))
                        {
                            <Button Small Text title="Use as the port players connect to" OnClick="() => UsePort(port)">
                                <Typography Code>@port</Typography>
                            </Button>
                        }
                    </Flex>
                }
                else
                {
                    <Typography Secondary Small>The container publishes no ports.</Typography>
                }

                @if (container.Mounts.Count > 0)
                {
                    <Typography Secondary Small>@container.Mounts.Count volume(s): @string.Join(", ", container.Mounts.Select(m => m.Destination))</Typography>
                }

                @if (!Context.IsNew)
                {
                    <Typography Secondary Small>Change the image, environment, ports and volumes on the Container page.</Typography>
                }
            </Flex>
        </ChildContent>
    </Card>
}

@code {
    [Parameter, EditorRequired] public ServerEngineEditorContext Context { get; set; } = default!;

    DockerServerSettings Settings => Context.GetSettings<DockerServerSettings>();

    IEnumerable<SelectItem<Guid?>> HostItems => Hosts.All.Select(h => new SelectItem<Guid?>(h.Id, h.Name)).ToList();

    IReadOnlyList<ContainerSummary> _containers = [];
    ContainerDefinition? _container;
    string? _workingDirectory;
    string? _state;
    string? _status;
    string? _error;
    bool _loading;

    // A new container's name and image, then its settings as read from the image
    ContainerDefinition? _creating;
    ContainerDefinition? _draft;
    bool _creatingNow;
    string? _progress;

    // Whether to install a new server's shared game files once it's created, and who else uses them
    bool _installGameFiles;
    IReadOnlyList<string> _gameFilesSharedWith = [];
    IReadOnlyList<string> _gameFilesLog = [];

    /// <summary>The host's containers by name; and the server's own, by id, if it was chosen before the plugin.</summary>
    IEnumerable<SelectItem<string>> ContainerItems
    {
        get
        {
            var items = _containers.Select(c => new SelectItem<string>(c.Name, $"{c.Name} · {c.Image} · {c.State}")).ToList();
            var current = Settings.ContainerId;

            if (!string.IsNullOrWhiteSpace(current) && items.All(i => i.Value != current))
            {
                var byId = _containers.FirstOrDefault(c => c.Id.StartsWith(current, StringComparison.OrdinalIgnoreCase));

                items.Insert(0, new SelectItem<string>(current, byId != null ? $"{byId.Name} · {byId.Image} · {byId.State}" : $"{current} (not found)"));
            }

            return items;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadContainersAsync();
    }

    async Task SetHostAsync(Guid? hostId)
    {
        Context.SetSettings(new DockerServerSettings { HostId = hostId });

        _container = null;
        _creating = null;
        _draft = null;

        await LoadContainersAsync();
    }

    async Task SetContainerAsync(string container)
    {
        var settings = Settings;

        settings.ContainerId = container ?? "";
        Context.SetSettings(settings);

        await LoadContainerAsync();
    }

    void SetFilesPath(string? path)
    {
        var settings = Settings;

        settings.FilesPath = string.IsNullOrWhiteSpace(path) ? null : path.Trim();
        Context.SetSettings(settings);
    }

    // The settings are read afresh each time, so a log file is found again by where it is in the list
    void ChangeLogFiles(Action<List<ContainerLogFile>> change)
    {
        var settings = Settings;

        change(settings.LogFiles);
        Context.SetSettings(settings);
    }

    void AddLogFile() => ChangeLogFiles(files => files.Add(new ContainerLogFile()));

    /// <summary>Changes the log file's name or path, whichever is given.</summary>
    void SetLogFile(int index, string? name, string? path) => ChangeLogFiles(files =>
    {
        if (index >= files.Count)
            return;

        files[index] = new ContainerLogFile
        {
            Name = name?.Trim() ?? files[index].Name,
            Path = path?.Trim() ?? files[index].Path,
        };
    });

    async Task LoadContainersAsync()
    {
        _error = null;

        if (Settings.HostId is not { } hostId)
        {
            _containers = [];
            return;
        }

        _loading = true;

        try
        {
            _containers = await Containers.ListAsync(hostId);
        }
        catch (Exception ex)
        {
            _containers = [];
            _error = $"The host's containers could not be listed: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }

        await LoadContainerAsync();
    }

    async Task LoadContainerAsync()
    {
        _container = null;
        _workingDirectory = null;

        if (Settings.HostId is not { } hostId || string.IsNullOrWhiteSpace(Settings.ContainerId))
            return;

        try
        {
            var inspected = await Containers.InspectAsync(hostId, Settings.ContainerId);

            if (inspected == null)
            {
                _error = $"The host has no container \"{Settings.ContainerId}\".";
                return;
            }

            _container = ContainerDefinition.From(inspected);
            _workingDirectory = inspected.Config?.WorkingDir;
            _state = inspected.State?.Status;
            _status = inspected.State?.Status switch
            {
                "running" => "Running",
                "exited" => $"Exited ({inspected.State.ExitCode})",
                { } other => System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(other),
                null => "Unknown",
            };
        }
        catch (Exception ex)
        {
            _error = $"The container could not be read: {ex.Message}";
        }
    }

    void StartCreating()
    {
        var name = new string((Context.Server.Name ?? "").ToLowerInvariant()
            .Select(c => char.IsAsciiLetterOrDigit(c) ? c : '-')
            .ToArray()).Trim('-');

        _creating = new ContainerDefinition { Name = string.IsNullOrEmpty(name) ? "game-server" : name };
        _draft = null;
        _progress = null;
    }

    void CancelCreating()
    {
        _creating = null;
        _draft = null;
        _progress = null;
    }

    IProgress<string> Progress() => new Progress<string>(message => InvokeAsync(() =>
    {
        _progress = message;
        StateHasChanged();
    }));

    /// <summary>Pulls and reads the image, to fill in the new container's settings from it.</summary>
    async Task ReadImageAsync()
    {
        if (_creating == null || Settings.HostId is not { } hostId)
            return;

        _creatingNow = true;

        try
        {
            _draft = await Containers.DefineFromImageAsync(hostId, _creating.Name, _creating.Image, Progress());
            _gameFilesSharedWith = [];
            _installGameFiles = false;

            if (_draft.GameFiles is { } gameFiles)
            {
                try
                {
                    _gameFilesSharedWith = (await Containers.ReadHostUsageAsync(hostId, []))
                        .SharersOf(gameFiles)
                        .Select(s => s.Container)
                        .Distinct()
                        .ToList();
                }
                catch (Exception)
                {
                    // Taken as unused; the administrator can still choose
                }

                _installGameFiles = _gameFilesSharedWith.Count == 0;
            }
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The image could not be read");
        }
        finally
        {
            _creatingNow = false;
            _progress = null;
        }
    }

    async Task CreateAsync()
    {
        if (_draft is not { } draft || Settings.HostId is not { } hostId)
            return;

        _creatingNow = true;

        try
        {
            var name = await Containers.CreateAsync(hostId, draft, Progress());

            Notifications.Success($"Created {name}");

            // While the card is still up to show how it's going
            if (_installGameFiles && draft.GameFiles != null)
                await InstallGameFilesAsync(hostId, name);

            _creating = null;
            _draft = null;

            await LoadContainersAsync();
            await SetContainerAsync(name);

            // A server image's files are browsed as the server sees them, with changes kept in its overlay
            if (ContainerDefinition.IsServerImage(draft.Image) && Settings.FilesPath == null)
                SetFilesPath("/config/Merged");

            if (Context.Server.Port == 0 && FirstPlayerPort(draft) is { } address)
                Context.SetAddress(address.Host, address.Port);
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The container could not be created");
        }
        finally
        {
            _creatingNow = false;
            _progress = null;
        }
    }

    /// <summary>Installs a new server's game files; the server is made either way, so a failure is only reported.</summary>
    async Task InstallGameFilesAsync(Guid hostId, string container)
    {
        try
        {
            _gameFilesLog = (await Containers.UpdateGameFilesAsync(hostId, container, Progress())).Log;

            Notifications.Success($"Game files install finished for {container}. Check its log for errors.");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, $"{container} was created, but its game files could not be installed. Try Update Game Files on its Container page once it's saved");
        }
    }

    /// <summary>
    /// Where players most likely connect to a new container: its first UDP port, or first port, at its
    /// own address if it has one. Null when that isn't known before it runs.
    /// </summary>
    static (string? Host, int Port)? FirstPlayerPort(ContainerDefinition spec)
    {
        var port = spec.Ports.FirstOrDefault(p => p.Protocol == "udp") ?? spec.Ports.FirstOrDefault();

        if (port == null)
            return null;

        if (!string.IsNullOrWhiteSpace(spec.IPAddress))
            return (spec.IPAddress.Trim(), port.ContainerPort);

        if (spec.Network.Trim() == "host")
            return (null, port.ContainerPort);

        return port.HostPort is { } hostPort ? (null, hostPort) : null;
    }

    /// <summary>Makes the port where players connect to the server; at the container's own address if it has one.</summary>
    void UsePort(PortMapping port)
    {
        if (_container is { IPAddress.Length: > 0 } container)
            Context.SetAddress(container.IPAddress, port.ContainerPort);
        else
            Context.SetAddress(null, port.HostPort);
    }
}
