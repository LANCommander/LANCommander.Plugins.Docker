@* A server's Container page: the container's image, command, network, ports, environment and volumes *@
@inject ContainerService Containers
@inject IServerProvider Servers
@inject NotificationService Notifications

@if (_loading)
{
    <Empty Description="Reading the container…" />
}
else if (_error != null)
{
    <Alert Danger Title="The container could not be read">@_error</Alert>
}
else if (_spec is { } spec && Settings.HostId is { } hostId)
{
    <Form Model="spec" OnSubmit="ApplyAsync" Class="edit-form">
        <Alert Info>
            Docker can't change these on an existing container, so applying them replaces it: the old container is stopped, a new one is created with the same volumes, and it's started again if it was running.
            Anything not shown here, such as its limits, is kept; what it only has from its image follows the image.
        </Alert>

        <ContainerForm @ref="_form" Spec="spec" HostId="hostId" Container="@Settings.ContainerId" />

        @if (_progress != null)
        {
            <Typography Secondary>@_progress</Typography>
        }

        <GameFilesLog Lines="_gameFilesLog" OnClose="() => _gameFilesLog = []" />

        <FormItem>
            <Flex Gap="Gap.Small">
                <Popconfirm OnConfirm="ApplyAsync" Title="Replace the container?" Description="It is stopped while it's replaced, and started again if it was running." OkText="Replace">
                    <Button Primary Loading="_applying" Disabled="Busy && !_applying">Apply</Button>
                </Popconfirm>
                <Popconfirm OnConfirm="UpdateImageAsync" Title="Update the image?" Description="The image is pulled again. If that brings a newer one, the container is replaced to use it, with the settings above." OkText="Update">
                    <Button Icon="IconType.ArrowClockwise" Loading="_updating" Disabled="Busy && !_updating">Update Image</Button>
                </Popconfirm>
                @if (spec.GameFiles != null)
                {
                    <Popconfirm OnConfirm="UpdateGameFilesAsync" Title="Update the game files?" Description="@($"Every server sharing {spec.GameFiles.Source} is stopped while the image installs or updates the game there, then started again if it was running.")" OkText="Update">
                        <Button Icon="IconType.DownloadSimple" Loading="_updatingFiles" Disabled="Busy && !_updatingFiles">Update Game Files</Button>
                    </Popconfirm>
                }
                <Button Disabled="Busy" OnClick="LoadAsync">Discard</Button>
            </Flex>
        </FormItem>
    </Form>
}

@code {
    [Parameter, EditorRequired] public ServerEngineServer Server { get; set; } = default!;

    // The server's settings as this page last saw or wrote them; the page's parameter is the server
    // as its editor loaded it, before any container this page replaced
    DockerServerSettings Settings { get; set; } = new();
    Guid _loadedFor;

    ContainerDefinition? _spec;
    ContainerForm? _form;
    bool _loading = true;
    bool _applying;
    bool _updating;
    bool _updatingFiles;
    IReadOnlyList<string> _gameFilesLog = [];
    string? _error;
    string? _progress;

    bool Busy => _applying || _updating || _updatingFiles;

    protected override async Task OnParametersSetAsync()
    {
        if (Server.Id == _loadedFor)
            return;

        _loadedFor = Server.Id;
        Settings = Server.GetSettings<DockerServerSettings>();

        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            if (Settings.HostId is not { } hostId || string.IsNullOrWhiteSpace(Settings.ContainerId))
            {
                _error = "Choose a Docker host and container on the server's General page first.";
                return;
            }

            var container = await Containers.InspectAsync(hostId, Settings.ContainerId);

            if (container == null)
                _error = $"The host has no container \"{Settings.ContainerId}\". Choose another on the server's General page.";
            else
                _spec = await Containers.DefinitionOfAsync(hostId, container);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    IProgress<string> Progress() => new Progress<string>(message => InvokeAsync(() =>
    {
        _progress = message;
        StateHasChanged();
    }));

    async Task ApplyAsync()
    {
        if (_spec == null || Settings.HostId is not { } hostId || Busy)
            return;

        _applying = true;

        try
        {
            var name = await Containers.RecreateAsync(hostId, Settings.ContainerId, _spec, Progress());

            await ReplacedAsync(name);

            Notifications.Success($"{name} replaced");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The container could not be replaced");
        }
        finally
        {
            _applying = false;
            _progress = null;
        }
    }

    async Task UpdateImageAsync()
    {
        if (_spec == null || Settings.HostId is not { } hostId || Busy)
            return;

        _updating = true;

        try
        {
            var update = await Containers.UpdateImageAsync(hostId, Settings.ContainerId, _spec, Progress());

            if (update.Replaced)
            {
                await ReplacedAsync(update.Container);

                Notifications.Success($"{update.Container} updated to the newest {_spec.Image}");
            }
            else
            {
                Notifications.Success($"{update.Container} already has the newest {_spec.Image}");
            }
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The image could not be updated");
        }
        finally
        {
            _updating = false;
            _progress = null;
        }
    }

    async Task UpdateGameFilesAsync()
    {
        if (_spec == null || Settings.HostId is not { } hostId || Busy)
            return;

        _updatingFiles = true;

        try
        {
            _gameFilesLog = [];

            var update = await Containers.UpdateGameFilesAsync(hostId, Settings.ContainerId, Progress());

            _gameFilesLog = update.Log;

            Notifications.Success(update.Restarted.Count > 0
                ? $"Game files update finished; {string.Join(", ", update.Restarted)} started again. Check its log for errors."
                : $"Game files update finished for {string.Join(", ", update.Sharing)}. Check its log for errors.");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The game files could not be updated");
        }
        finally
        {
            _updatingFiles = false;
            _progress = null;
        }

        if (_form != null)
            await _form.LoadUsesAsync();
    }

    /// <summary>Points the server at the container that replaced its old one, and reads it.</summary>
    async Task ReplacedAsync(string name)
    {
        // The server names the container; keep it pointing at the new one
        if (name != Settings.ContainerId && await Servers.GetAsync(Server.Id) is { } server)
        {
            var settings = server.EngineSettings is { Length: > 0 } saved
                ? ServerEngineSettings.Read<DockerServerSettings>(saved)
                : Settings;

            settings.ContainerId = name;

            await Servers.UpdateAsync(server with { EngineSettings = ServerEngineSettings.Write(settings) });

            Settings = settings;
        }

        await LoadAsync();

        if (_form != null)
            await _form.LoadUsesAsync();
    }
}
